[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/pause_panel.gd" id="1_pause"]

[node name="PausePanel" type="CanvasLayer"]
layer = 100
process_mode = 3
visible = false
script = ExtResource("1_pause")

[node name="Shade" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.68)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/VBox"]
